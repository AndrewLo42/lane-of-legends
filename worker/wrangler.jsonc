{
  // Lane League PvP server on Cloudflare Workers + Durable Objects (see worker/index.ts).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lane-league-pvp",
  "main": "index.ts",
  "compatibility_date": "2026-09-27",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "dev": { "port": 8787 }
}

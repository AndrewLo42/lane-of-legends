{
  "name": "lane-league",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p worker",
    "meshy": "node --experimental-strip-types --no-warnings tools/meshy/cli.ts",
    "server": "vite-node server/main.ts",
    "server:cf": "wrangler dev -c worker/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy -c worker/wrangler.jsonc"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "4.142.0"
  }
}
